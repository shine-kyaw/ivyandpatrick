# Google Sheet webhook (see scripts/google-apps-script.gs). Required in production.
RSVP_WEBHOOK_URL=
RSVP_WEBHOOK_SECRET=

# Optional: override the guest password without a code change.
# Generate with: npm run password -- "new password"
SITE_PASSWORD_VERIFIER=

# Optional: shared rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
